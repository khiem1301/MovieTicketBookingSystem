<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Yêu cầu: pgPath, pgCurrent, pgTotal; tuỳ chọn: pgPageParam (mặc định page), pgQueryExtra, pgTotalItems --%>
<c:if test="${empty pgPageParam}"><c:set var="pgPageParam" value="page"/></c:if>
<c:if test="${empty pgQueryExtra}"><c:set var="pgQueryExtra" value=""/></c:if>
<c:if test="${pgTotal > 1}">
  <div class="bh-pagination">
    <span class="bh-pagination-info">
      Trang <c:out value="${pgCurrent}"/> / <c:out value="${pgTotal}"/>
      <c:if test="${not empty pgTotalItems}">
        — Tổng <strong><c:out value="${pgTotalItems}"/></strong>
      </c:if>
    </span>
    <div class="bh-pagination-actions">
      <c:if test="${pgCurrent > 1}">
        <a class="bh-btn bh-btn--ghost"
           href="${pgPath}?${pgPageParam}=${pgCurrent - 1}${pgQueryExtra}">← Trang trước</a>
      </c:if>
      <c:if test="${pgCurrent < pgTotal}">
        <a class="bh-btn bh-btn--ghost bh-btn--more"
           href="${pgPath}?${pgPageParam}=${pgCurrent + 1}${pgQueryExtra}">
          Xem thêm lịch sử
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </c:if>
    </div>
  </div>
</c:if>
