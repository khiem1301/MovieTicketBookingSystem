<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Yeu cau: pgPath, pgCurrent, pgTotal; tuy chon: pgPageParam (mac dinh page), pgQueryExtra, pgTotalItems --%>
<c:if test="${empty pgPageParam}"><c:set var="pgPageParam" value="page"/></c:if>
<c:if test="${empty pgQueryExtra}"><c:set var="pgQueryExtra" value=""/></c:if>
<c:if test="${pgTotal > 1}">
  <div class="admin-pagination">
    <span class="admin-pagination-info">
      Trang <c:out value="${pgCurrent}"/> / <c:out value="${pgTotal}"/>
      <c:if test="${not empty pgTotalItems}">
        &mdash; T&#7893;ng <strong><c:out value="${pgTotalItems}"/></strong>
      </c:if>
    </span>
    <div class="admin-btn-group">
      <c:if test="${pgCurrent > 1}">
        <a class="admin-btn admin-btn--ghost admin-btn--sm admin-pagination-nav"
           href="${pgPath}?${pgPageParam}=${pgCurrent - 1}${pgQueryExtra}"
           aria-label="Trang truoc">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Tr&#432;&#7899;c
        </a>
      </c:if>
      <c:if test="${pgCurrent < pgTotal}">
        <a class="admin-btn admin-btn--ghost admin-btn--sm admin-pagination-nav"
           href="${pgPath}?${pgPageParam}=${pgCurrent + 1}${pgQueryExtra}"
           aria-label="Trang sau">
          Sau
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </c:if>
    </div>
  </div>
</c:if>
